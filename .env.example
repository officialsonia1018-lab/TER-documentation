# Copy to .env.local for local overrides. Never commit real secrets.

# Frontend (build-time, Vite): Render backend URL when the site is hosted
# separately, e.g. https://ter-backend.onrender.com
VITE_API_BASE_URL=

# Backend variables are read from the process environment (Render dashboard,
# or your terminal for local runs):
# DB_HOST=
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
# DB_SSL=1
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# CORS_ORIGIN=https://your-frontend.vercel.app
